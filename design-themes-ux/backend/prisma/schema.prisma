generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  password      String
  avatar        String?
  role          UserRole       @default(STORE_STAFF)
  storeId       String?
  isActive      Boolean        @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  auditLogs     AuditLog[]
  blogPosts     BlogPost[]     @relation("BlogAuthor")
  orderNotes    OrderNote[]
  refreshTokens RefreshToken[]
  staffOf       StoreStaff[]
  ownedStore    Store?         @relation("StoreOwner")

  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Plan {
  id            String         @id @default(cuid())
  name          String
  tier          PlanTier       @unique
  description   String?        @db.Text
  price         Decimal        @db.Decimal(10, 2)
  yearlyPrice   Decimal        @db.Decimal(10, 2)
  isActive      Boolean        @default(true)
  isPopular     Boolean        @default(false)
  maxProducts   Int?
  maxStaff      Int?
  maxOrders     Int?
  maxStorage    Int?
  maxApiCalls   Int?
  features      String         @db.LongText
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                 String             @id @default(cuid())
  storeId            String             @unique
  planId             String
  status             SubscriptionStatus @default(TRIAL)
  billingCycle       String             @default("MONTHLY")
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  cancelledAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  invoices           Invoice[]
  plan               Plan               @relation(fields: [planId], references: [id])
  store              Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([planId], map: "subscriptions_planId_fkey")
  @@map("subscriptions")
}

model Invoice {
  id             String        @id @default(cuid())
  storeId        String
  subscriptionId String?
  amount         Decimal       @db.Decimal(10, 2)
  status         InvoiceStatus @default(OPEN)
  description    String?
  pdfUrl         String?
  dueAt          DateTime?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  store          Store         @relation(fields: [storeId], references: [id])
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([storeId], map: "invoices_storeId_fkey")
  @@index([subscriptionId], map: "invoices_subscriptionId_fkey")
  @@map("invoices")
}

model Store {
  id                 String                @id @default(cuid())
  name               String
  slug               String                @unique
  domain             String                @unique
  businessType       BusinessType          @default(FASHION)
  status             StoreStatus           @default(TRIAL)
  ownerId            String                @unique
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  analyticsEvents    AnalyticsEvent[]
  attributeSets      AttributeSet[]
  attributes         Attribute[]
  auditLogs          AuditLog[]            @relation("StoreAuditLogs")
  blogPosts          BlogPost[]
  brands             Brand[]
  builderPages       BuilderPage[]         @relation("BuilderPages")
  builderSections    BuilderSection[]      @relation("BuilderSections")
  campaigns          Campaign[]
  categories         Category[]
  cmsPages           CmsPage[]
  collections        Collection[]
  componentDefs      ComponentDefinition[] @relation("ComponentDefinitions")
  coupons            Coupon[]
  customers          Customer[]
  emailTemplates     EmailTemplate[]
  footerConfigs      FooterConfig[]
  headerConfigs      HeaderConfig[]
  invoices           Invoice[]
  loyaltyAccounts    LoyaltyAccount[]
  menus              Menu[]
  merchandisingRules MerchandisingRule[]
  orders             Order[]
  pageDocuments      PageDocument[]        @relation("PageDocuments")
  products           Product[]
  searchConfig       SearchConfig?
  searchQueries      SearchQuery[]
  synonyms           SearchSynonym[]
  sectionDefinitions SectionDefinition[]
  settings           StoreSettings?
  staff              StoreStaff[]
  themes             StoreTheme[]
  owner              User                  @relation("StoreOwner", fields: [ownerId], references: [id])
  subscription       Subscription?
  suppliers          Supplier[]
  symbolDocuments    SymbolDocument[]      @relation("SymbolDocuments")
  themeConfigs       ThemeConfig[]
  themeDocuments     ThemeDocument[]       @relation("ThemeDocuments")
  themePageBlocks    ThemePageBlock[]      @relation("ThemePageBlocks")
  themePageSections  ThemePageSection[]    @relation("ThemePageSections")
  themePresets       ThemePreset[]
  warehouses         Warehouse[]
  paymentConfig      StorePaymentConfig?

  @@map("stores")
}

model StoreSettings {
  id                String   @id @default(cuid())
  storeId           String   @unique
  logo              String?
  favicon           String?
  primaryColor      String   @default("#4f46e5")
  currency          String   @default("INR")
  language          String   @default("en")
  timezone          String   @default("Asia/Kolkata")
  metaTitle         String?
  metaDescription   String?  @db.Text
  taxEnabled        Boolean  @default(false)
  taxRate           Decimal  @default(0.00) @db.Decimal(5, 2)
  facebook          String?
  instagram         String?
  twitter           String?
  youtube           String?
  orderEmailEnabled Boolean  @default(true)
  lowStockThreshold Int      @default(10)
  updatedAt         DateTime @updatedAt
  store             Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_settings")
}

model StoreStaff {
  id          String   @id @default(cuid())
  storeId     String
  userId      String
  role        String   @default("STAFF")
  invitedById String?
  joinedAt    DateTime @default(now())
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])

  @@unique([storeId, userId])
  @@index([userId], map: "store_staff_userId_fkey")
  @@map("store_staff")
}

model Brand {
  id              String    @id @default(cuid())
  storeId         String
  name            String
  slug            String
  description     String?   @db.Text
  logo            String?
  bannerImage     String?
  websiteUrl      String?
  metaTitle       String?
  metaDescription String?   @db.Text
  isFeatured      Boolean   @default(false)
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  store           Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products        Product[]

  @@unique([storeId, slug])
  @@map("brands")
}

model Collection {
  id          String              @id @default(cuid())
  storeId     String
  name        String
  slug        String
  description String?             @db.Text
  image       String?
  type        CollectionType      @default(MANUAL)
  rules       String?             @db.LongText
  sortBy      String              @default("MANUAL")
  isFeatured  Boolean             @default(false)
  isActive    Boolean             @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  store       Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products    ProductCollection[]

  @@unique([storeId, slug])
  @@map("collections")
}

model ProductCollection {
  id           String     @id @default(cuid())
  productId    String
  collectionId String
  isPinned     Boolean    @default(false)
  sortOrder    Int        @default(0)
  addedAt      DateTime   @default(now())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, collectionId])
  @@index([collectionId], map: "product_collections_collectionId_fkey")
  @@map("product_collections")
}

model Attribute {
  id           String             @id @default(cuid())
  storeId      String
  name         String
  slug         String
  type         AttributeType      @default(DROPDOWN)
  isRequired   Boolean            @default(false)
  isFilterable Boolean            @default(true)
  isVisible    Boolean            @default(true)
  sortOrder    Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  sets         AttributeSetItem[]
  values       AttributeValue[]
  store        Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, slug])
  @@map("attributes")
}

model AttributeValue {
  id          String                  @id @default(cuid())
  attributeId String
  value       String
  label       String
  color       String?
  image       String?
  sortOrder   Int                     @default(0)
  attribute   Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  products    ProductAttributeValue[]

  @@index([attributeId], map: "attribute_values_attributeId_fkey")
  @@map("attribute_values")
}

/// Join table linking products to filterable attribute values (fabric,
/// material, occasion, pattern, etc.) — powers storefront facet filtering.
model ProductAttributeValue {
  id               String         @id @default(cuid())
  productId        String
  attributeValueId String
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeValueId])
  @@index([attributeValueId], map: "product_attribute_values_attributeValueId_fkey")
  @@map("product_attribute_values")
}

model AttributeSet {
  id         String             @id @default(cuid())
  storeId    String
  name       String
  createdAt  DateTime           @default(now())
  attributes AttributeSetItem[]
  store      Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId], map: "attribute_sets_storeId_fkey")
  @@map("attribute_sets")
}

model AttributeSetItem {
  id             String       @id @default(cuid())
  attributeSetId String
  attributeId    String
  sortOrder      Int          @default(0)
  attribute      Attribute    @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  attributeSet   AttributeSet @relation(fields: [attributeSetId], references: [id], onDelete: Cascade)

  @@unique([attributeSetId, attributeId])
  @@index([attributeId], map: "attribute_set_items_attributeId_fkey")
  @@map("attribute_set_items")
}

model Category {
  id                  String         @id @default(cuid())
  storeId             String
  parentId            String?
  name                String
  slug                String
  description         String?        @db.Text
  image               String?
  sortOrder           Int            @default(0)
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?
  attributeSetId      String?
  bannerImage         String?
  isFeatured          Boolean        @default(false)
  landingPageSections String?        @db.LongText
  menuVisibility      MenuVisibility @default(BOTH)
  metaDescription     String?        @db.Text
  metaTitle           String?
  rules               String?        @db.LongText
  showOnHomepage      Boolean        @default(false)
  parent              Category?      @relation("CategoryTree", fields: [parentId], references: [id])
  children            Category[]     @relation("CategoryTree")
  store               Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products            Product[]

  @@unique([storeId, slug])
  @@index([parentId], map: "categories_parentId_fkey")
  @@map("categories")
}

model Product {
  id                String                  @id @default(cuid())
  storeId           String
  categoryId        String?
  name              String
  slug              String
  description       String?                 @db.LongText
  shortDescription  String?                 @db.Text
  price             Decimal                 @db.Decimal(10, 2)
  comparePrice      Decimal?                @db.Decimal(10, 2)
  costPrice         Decimal?                @db.Decimal(10, 2)
  sku               String
  barcode           String?
  weight            Decimal?                @db.Decimal(8, 2)
  status            ProductStatus           @default(DRAFT)
  isFeatured        Boolean                 @default(false)
  trackInventory    Boolean                 @default(true)
  stock             Int                     @default(0)
  lowStockThreshold Int                     @default(5)
  images            String                  @db.LongText
  thumbnail         String?
  tags              String                  @db.LongText
  seo               String?                 @db.Text
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  deletedAt         DateTime?
  approvalStatus    ApprovalStatus          @default(DRAFT)
  badges            String?                 @db.LongText
  brandId           String?
  crossSellIds      String?                 @db.LongText
  internalNotes     String?                 @db.Text
  publishAt         DateTime?
  relatedProductIds String?                 @db.LongText
  templateType      String?
  upsellIds         String?                 @db.LongText
  hsCode            String?
  priceIncludesTax  Boolean                 @default(false)
  taxCategory       String?
  orderItems        OrderItem[]
  collections       ProductCollection[]
  reviews           ProductReview[]
  variants          ProductVariant[]
  versions          ProductVersion[]
  attributeValues   ProductAttributeValue[]
  brand             Brand?                  @relation(fields: [brandId], references: [id])
  category          Category?               @relation(fields: [categoryId], references: [id])
  store             Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, slug])
  @@unique([storeId, sku])
  @@index([storeId, status])
  @@index([brandId], map: "products_brandId_fkey")
  @@index([categoryId], map: "products_categoryId_fkey")
  @@map("products")
}

model ProductVersion {
  id         String   @id @default(cuid())
  productId  String
  version    Int
  snapshot   Json
  changedBy  String?
  changeNote String?
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId], map: "product_versions_productId_fkey")
  @@map("product_versions")
}

model ProductVariant {
  id           String      @id @default(cuid())
  productId    String
  name         String
  sku          String
  price        Decimal     @db.Decimal(10, 2)
  comparePrice Decimal?    @db.Decimal(10, 2)
  stock        Int         @default(0)
  image        String?
  options      String?     @db.LongText
  createdAt    DateTime    @default(now())
  orderItems   OrderItem[]
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId], map: "product_variants_productId_fkey")
  @@map("product_variants")
}

model ProductReview {
  id         String   @id @default(cuid())
  productId  String
  customerId String
  rating     Int
  title      String?
  body       String?  @db.Text
  isVerified Boolean  @default(false)
  isVisible  Boolean  @default(true)
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])

  @@index([customerId], map: "product_reviews_customerId_fkey")
  @@index([productId], map: "product_reviews_productId_fkey")
  @@map("product_reviews")
}

model Warehouse {
  id        String           @id @default(cuid())
  storeId   String
  name      String
  location  String
  address   String?          @db.Text
  manager   String?
  phone     String?
  status    String           @default("ACTIVE")
  capacity  Int              @default(10000)
  createdAt DateTime         @default(now())
  movements StockMovement[]
  stock     WarehouseStock[]
  store     Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId], map: "warehouses_storeId_fkey")
  @@map("warehouses")
}

model WarehouseStock {
  id          String    @id @default(cuid())
  warehouseId String
  productId   String
  stock       Int       @default(0)
  reserved    Int       @default(0)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([warehouseId, productId])
  @@map("warehouse_stock")
}

model Supplier {
  id             String          @id @default(cuid())
  storeId        String
  name           String
  contactName    String?
  email          String?
  phone          String?
  website        String?
  currency       String          @default("INR")
  leadTime       String?
  rating         Decimal         @default(0.00) @db.Decimal(3, 2)
  status         String          @default("ACTIVE")
  address        String?         @db.Text
  notes          String?         @db.Text
  createdAt      DateTime        @default(now())
  purchaseOrders PurchaseOrder[]
  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId], map: "suppliers_storeId_fkey")
  @@map("suppliers")
}

model StockMovement {
  id          String       @id @default(cuid())
  storeId     String
  productId   String
  warehouseId String?
  type        MovementType
  quantity    Int
  reason      String?
  reference   String?
  createdById String?
  createdAt   DateTime     @default(now())
  warehouse   Warehouse?   @relation(fields: [warehouseId], references: [id])

  @@index([warehouseId], map: "stock_movements_warehouseId_fkey")
  @@map("stock_movements")
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  storeId      String
  supplierId   String
  poNumber     String              @unique
  status       String              @default("DRAFT")
  total        Decimal             @db.Decimal(10, 2)
  notes        String?             @db.Text
  expectedDate DateTime?
  receivedAt   DateTime?
  createdById  String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  items        PurchaseOrderItem[]
  supplier     Supplier            @relation(fields: [supplierId], references: [id])

  @@index([supplierId], map: "purchase_orders_supplierId_fkey")
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  receivedQty     Int           @default(0)
  unitCost        Decimal       @db.Decimal(10, 2)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@index([purchaseOrderId], map: "purchase_order_items_purchaseOrderId_fkey")
  @@map("purchase_order_items")
}

model Order {
  id                   String               @id @default(cuid())
  storeId              String
  customerId           String?
  orderNumber          String
  status               OrderStatus          @default(PENDING)
  paymentStatus        PaymentStatus        @default(PENDING)
  paymentMethod        String?
  subtotal             Decimal              @db.Decimal(10, 2)
  discount             Decimal              @default(0.00) @db.Decimal(10, 2)
  tax                  Decimal              @default(0.00) @db.Decimal(10, 2)
  shippingCost         Decimal              @default(0.00) @db.Decimal(10, 2)
  total                Decimal              @db.Decimal(10, 2)
  refundedAmount       Decimal              @default(0.00) @db.Decimal(10, 2)
  shippingAddress      String?              @db.LongText
  billingAddress       String?              @db.LongText
  couponCode           String?
  customerNote         String?              @db.Text
  checkoutSessionId    String?
  paymentTransactionId String?
  paymentGatewayCode   String?              @db.VarChar(20)
  confirmedAt          DateTime?
  // Milestone 8's migration (20260703000000_m8_order_cancellation) created these
  // two columns as snake_case, unlike every other column on this table — @map
  // corrects the mismatch without needing a new migration (the physical columns
  // already exist under these names).
  cancelledAt          DateTime?            @map("cancelled_at")
  cancellationReason   String?              @db.Text @map("cancellation_reason")
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  items                OrderItem[]
  notes                OrderNote[]
  statusHistory        OrderStatusHistory[]
  customer             Customer?            @relation(fields: [customerId], references: [id])
  store                Store                @relation(fields: [storeId], references: [id])
  refunds              Refund[]
  shipments            Shipment[]
  snapshot             OrderSnapshot?

  @@unique([storeId, orderNumber])
  @@index([orderNumber])
  @@index([storeId, status])
  @@index([storeId, createdAt])
  @@index([customerId], map: "orders_customerId_fkey")
  @@map("orders")
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  productId      String
  variantId      String?
  productName    String
  variantName    String?
  sku            String
  quantity       Int
  unitPrice      Decimal         @db.Decimal(10, 2)
  total          Decimal         @db.Decimal(10, 2)
  brandName      String?         @db.VarChar(200)
  brandSlug      String?         @db.VarChar(200)
  thumbnail      String?         @db.VarChar(1000)
  variantOptions Json?
  comparePrice   Decimal?        @db.Decimal(10, 2)
  lineDiscount   Decimal         @default(0.00) @db.Decimal(10, 2)
  taxRate        Decimal         @default(0.0000) @db.Decimal(5, 4)
  taxAmount      Decimal         @default(0.00) @db.Decimal(10, 2)
  taxClass       String?         @db.VarChar(20)
  hsn            String?         @db.VarChar(20)
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id])
  variant        ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId], map: "order_items_orderId_fkey")
  @@index([productId], map: "order_items_productId_fkey")
  @@index([variantId], map: "order_items_variantId_fkey")
  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?     @db.Text
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId], map: "order_status_history_orderId_fkey")
  @@map("order_status_history")
}

model OrderNote {
  id         String   @id @default(cuid())
  orderId    String
  userId     String?
  content    String   @db.Text
  isInternal Boolean  @default(true)
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([orderId], map: "order_notes_orderId_fkey")
  @@index([userId], map: "order_notes_userId_fkey")
  @@map("order_notes")
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String
  trackingNumber String?
  carrier        String?
  status         String         @default("PENDING")
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  order          Order          @relation(fields: [orderId], references: [id])
  items          ShipmentItem[]

  @@index([orderId], map: "shipments_orderId_fkey")
  @@map("shipments")
}

model Refund {
  id                   String   @id @default(cuid())
  orderId              String
  amount               Decimal  @db.Decimal(10, 2)
  reason               String?  @db.Text
  status               String   @default("PENDING")
  processedById        String?
  paymentTransactionId String?
  gatewayRefundId      String?  @db.VarChar(200)
  amountInPaise        Int      @default(0)
  createdAt            DateTime @default(now())
  order                Order    @relation(fields: [orderId], references: [id])

  @@index([orderId], map: "refunds_orderId_fkey")
  @@map("refunds")
}

model Customer {
  id                 String                      @id @default(cuid())
  storeId            String
  email              String
  name               String
  phone              String?
  avatar             String?
  segment            CustomerSegment             @default(NEW)
  totalOrders        Int                         @default(0)
  totalSpent         Decimal                     @default(0.00) @db.Decimal(10, 2)
  lastOrderAt        DateTime?
  isActive           Boolean                     @default(true)
  notes              String?                     @db.Text
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  deletedAt          DateTime?
  addresses          CustomerAddress[]
  store              Store                       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  loyalty            LoyaltyAccount?
  orders             Order[]
  reviews            ProductReview[]
  credential         CustomerCredential?
  refreshTokens      CustomerRefreshToken[]
  verificationTokens CustomerVerificationToken[]

  @@unique([storeId, email])
  @@index([storeId, segment])
  @@map("customers")
}

// ─── FI-1: Customer Identity Platform ────────────────────────────────────────
// Isolated from User/RefreshToken (merchant auth). One customer has at most
// one credential row; a customer with no row here has never registered
// (e.g. created via admin CRM import or as an order's contact only).
model CustomerCredential {
  id                  String    @id @default(cuid())
  customerId          String    @unique
  passwordHash        String
