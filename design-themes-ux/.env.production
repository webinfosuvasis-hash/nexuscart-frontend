# ─── Storefront Environment — Production ──────────────────────────────────────
#
# Loaded automatically by `vite build` (default mode "production").
# To point a future deployment at a different backend, edit VITE_API_BASE_URL
# here only — nothing in src/ should ever hardcode an environment URL.
#
# Vite exposes only VITE_* variables to the browser bundle.

# NexusCart backend API base URL (no trailing slash).
#
# Absolute, because the frontend and backend are deployed as separate Railway
# services on separate *.up.railway.app domains — there's no shared origin to
# proxy through the way EC2's Nginx did. CORS_ORIGIN on the backend must list
# this frontend's domain (see railway_deploy memory / project docs).
VITE_API_BASE_URL=https://nexuscart-backend-production-04c3.up.railway.app/api/v1

# Store ID to use for API calls (same store as development — see .env.development for how to find it).
VITE_STORE_ID=cmqpfhdsf0003bhb9df1jq8j2

# ─── Feature Flags ────────────────────────────────────────────────────────────
VITE_DATA_DRIVEN_HOME=true
